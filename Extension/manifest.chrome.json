{
  "manifest_version": 3,
  "name": "MacDM — Mac Download Manager",
  "version": "0.2.0",
  "description": "Send downloads and videos to MacDM: multi-connection downloads, quality picker for video sites, browser takeover.",
  "minimum_chrome_version": "111",
  "key": "",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "webRequest",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "lib/hdm.js",
        "content.js"
      ],
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "HDM"
  }
}