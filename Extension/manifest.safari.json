{
  "manifest_version": 3,
  "name": "HDM — Hiz Download Manager",
  "version": "0.2.0",
  "description": "Send downloads and videos to Hiz Download Manager: multi-connection downloads, quality picker for video sites.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["cookies", "contextMenus", "nativeMessaging", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["lib/hdm.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["lib/hdm.js", "content.js"],
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["page-hook.js"], "matches": ["<all_urls>"] }
  ],
  "action": { "default_popup": "popup/popup.html", "default_title": "HDM" }
}
